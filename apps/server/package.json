{
  "name": "@sideline/server",
  "version": "0.1.0",
  "private": true,
  "description": "Sideline API: sessions, match clock, SSE stream, AI gateway, telemetry. Runs TypeScript directly on Node 24 (no build step).",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@hono/node-server": "^2.1.3",
    "@sideline/engine": "workspace:*",
    "hono": "^4.13.12",
    "openai": "7.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "~24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
