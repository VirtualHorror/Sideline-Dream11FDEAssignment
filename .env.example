# Sideline server configuration. Copy to .env (git-ignored) for local runs; production reads
# /etc/sideline/sideline.env (mode 600, Task 7). Empty values mean "unset".

# --- HTTP (Task 1) ---
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
# SIDELINE_DATA_DIR=/absolute/path/to/data          (default: <repo>/data)
# SIDELINE_WEB_DIST=/absolute/path/to/apps/web/dist (default: <repo>/apps/web/dist)

# --- AI provider (Task 1 parses these; Task 5 uses them) ---
# Leave both keys empty to run on deterministic logic + replayed AI only.
# Provider order when SIDELINE_AI_PROVIDER is unset: Anthropic if its key is set, else OpenAI.
SIDELINE_AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Models and spend (Task 5) ---
# Anthropic default for both tiers is claude-opus-5-5 (per-skill effort keeps it quick).
# For the cheapest/fastest lane set SIDELINE_MODEL_FAST=claude-haiku-5-5.
SIDELINE_MODEL_FAST=
SIDELINE_MODEL_SMART=
# Required when SIDELINE_AI_PROVIDER=openai (no default model is assumed):
SIDELINE_OPENAI_MODEL=
# Hard daily cap on estimated model spend in USD; above it the app switches to replay/fallback.
SIDELINE_AI_DAILY_BUDGET_USD=3
# Per-IP limit on fan questions (requests per minute) and per-session AI call cap.
SIDELINE_ASK_PER_MINUTE=12
SIDELINE_SESSION_AI_CAP=80
