# Sideline server configuration. Copy to .env (git-ignored, chmod 600) for local runs; production
# reads /etc/sideline/sideline.env, generated from .env by deploy/install.sh (Task 7).
# Empty values mean "unset". Never commit real keys.

# --- HTTP (Task 1) ---
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
# SIDELINE_DATA_DIR=/absolute/path/to/data          (default: <repo>/data)
# SIDELINE_WEB_DIST=/absolute/path/to/apps/web/dist (default: <repo>/apps/web/dist)

# --- AI provider (D-033; Task 1 parses the keys, Task 5 uses everything below) ---
# With no key, Sideline runs on deterministic logic plus replayed AI output.
# Default provider = whichever key is present (Anthropic first if both are set);
# SIDELINE_AI_PROVIDER=anthropic|openai|none overrides.
SIDELINE_AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint. Empty = api.openai.com.
# Example (the endpoint Codex uses on this machine): OPENAI_BASE_URL=https://api.proxy.pro/v1
OPENAI_BASE_URL=

# --- Models (Task 5) ---
# Anthropic defaults to claude-opus-5-5 for both tiers (claude-haiku-5-5 is a cheaper fast lane).
# Required when the provider is openai: model names differ per endpoint (proxy: gpt-6.1-sol).
SIDELINE_MODEL_FAST=
SIDELINE_MODEL_SMART=

# --- Spend and limits (Task 5) ---
# USD per million tokens for models without a built-in price (shown as estimates).
SIDELINE_PRICE_IN_PER_MTOK=5
SIDELINE_PRICE_OUT_PER_MTOK=20
# Hard daily cap on estimated model spend; above it the app switches to replay/fallback.
SIDELINE_AI_DAILY_BUDGET_USD=3
# Per-IP limit on fan questions (requests per minute) and per-session AI call cap.
SIDELINE_ASK_PER_MINUTE=12
SIDELINE_SESSION_AI_CAP=80
