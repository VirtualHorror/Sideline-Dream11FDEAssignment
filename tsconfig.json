{
  // Type-checks repo-level TypeScript that no workspace package owns: scripts/, e2e/ and
  // the root tool configs. Packages have their own tsconfig.json (see `pnpm typecheck`).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom"],
    "types": ["node"]
  },
  "include": ["scripts", "e2e", "playwright.config.ts", "vitest.config.ts"]
}
