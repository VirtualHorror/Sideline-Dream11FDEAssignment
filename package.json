{
  "name": "sideline",
  "version": "0.1.0",
  "private": true,
  "description": "Sideline: an agentic second-screen companion for live cricket. Dream11 FDE Intern assignment by Nabhanyu.",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sideline/server --filter @sideline/web dev",
    "dev:server": "pnpm --filter @sideline/server dev",
    "dev:web": "pnpm --filter @sideline/web dev",
    "build": "pnpm --filter @sideline/web build",
    "start": "node apps/server/src/index.ts",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:hardcode": "node scripts/check-no-hardcode.ts",
    "check:data": "node scripts/verify-data.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:hardcode && pnpm check:data && pnpm build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "~24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
